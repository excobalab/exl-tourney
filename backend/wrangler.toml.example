name = "exl-tournaments"
main = "src/index.js"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

# D1 database — paste the id printed by `npx wrangler d1 create exl-tournaments`
[[d1_databases]]
binding = "DB"
database_name = "exl-tournaments"
database_id = "YOUR_D1_DATABASE_ID"

[triggers]
crons = ["*/5 * * * *"]   # every 5 min — start/cancel duel rooms, settle finished tournaments, pay out

[vars]
# "1" = simulate payouts (no on-chain transfer). Set to "0" only after an end-to-end test.
DRY_RUN = "1"
# Comma-separated list = failover order. api.mainnet-beta.solana.com rejects Cloudflare Workers (403) — use a
# free Helius/QuickNode/Triton endpoint instead, e.g. "https://mainnet.helius-rpc.com/?api-key=XXX,https://solana-rpc.publicnode.com"
RPC_URL = "https://solana-rpc.publicnode.com"
# PUBLIC address of the prize-pool wallet (generate with tools/pool_wallet.html)
POOL_ADDRESS = "YOUR_POOL_WALLET_PUBLIC_KEY"
# Wallet that receives the service fee (1/3/5 %)
COMMISSION_ADDRESS = "YOUR_FEE_WALLET_PUBLIC_KEY"
# SKR tournaments (leave empty to disable). Seeker token mint, classic SPL Token program, 6 decimals.
SKR_MINT = "SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3"
# "1" = low-fee launch tournaments (0.01 SOL / 50 SKR daily) for onboarding; "0" = real fees
LAUNCH_MODE = "0"

# SECRETS (never commit):
#   npx wrangler secret put POOL_SECRET   -> pool wallet secret key as JSON array ([12,34,...] 64 numbers)
#   npx wrangler secret put SEED_SALT     -> long random string (tournament seed salt)
#   npx wrangler secret put ADMIN_KEY     -> password for /admin/* endpoints
# Optional: TG_TOKEN, TG_CHAT (Telegram), X_API_KEY, X_API_SECRET, X_ACCESS_TOKEN, X_ACCESS_SECRET (X/Twitter)
